# ==============================================================================
# CURE CRAFT — ENVIRONMENT CONFIGURATION
# Configure these variables in:
# 1. Local development (.env)
# 2. Vercel: Project Settings -> Environment Variables (Production & Preview)
# ==============================================================================

# ADMIN_PASSWORD: Password to authenticate and manage owner branding at /admin/branding
# Default fallback if unset: curecraft-admin-2025
ADMIN_PASSWORD="curecraft-admin-2025"

# SUPABASE_URL: Your Supabase Project URL (e.g., https://your-project.supabase.co)
# Required for permanent cloud image storage across browser sessions, devices, and Vercel deployments.
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Private service-role key for server-side storage and database writes.
# Keep this private (never expose in client code). On Vercel, add to Environment Variables.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# SUPABASE_STORAGE_BUCKET: The Supabase Storage bucket for storing branding images.
# Default: branding-assets (must be set to public in Supabase Storage)
SUPABASE_STORAGE_BUCKET="branding-assets"

# Optional client-side Supabase credentials if client-direct access is ever needed:
# VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-anon-key"

# GEMINI_API_KEY: Injected by AI Studio if AI features are used
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
